{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/mindcare run build:vercel",
  "outputDirectory": "artifacts/mindcare/dist/public",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}